# ============================================================
# Template de configuration - Gaslands Manager
#
# Copier ce fichier en ".env" et remplir les valeurs réelles.
#   cp .env.example .env
#
# Ce fichier (.env.example) est commité sur GitHub.
# Le fichier .env ne l'est JAMAIS (voir .gitignore).
#
# CE FICHIER (racine) alimente Docker Compose (docker-compose.yml /
# docker-compose.prod.yml) - les variables sont injectées dans les
# conteneurs via `environment:`. Il est distinct de apps/backend/.env, qui
# alimente `npx nx serve backend` en développement local hors Docker (voir
# apps/backend/.env.example) : les deux fichiers coexistent et ne se
# substituent jamais l'un à l'autre.
#
# Le backend valide ces variables au démarrage (apps/backend/src/app/config/
# env.validation.ts) - une valeur manquante ou invalide (secret par défaut
# "change_me", trop court...) fait échouer le démarrage avec un message
# nommant la variable fautive, surtout en NODE_ENV=production.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
DB_USER=gaslands
DB_PASSWORD=change_me
DB_NAME=gaslands

# ── pgAdmin (interface web, http://localhost:5050) ───────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# ── Authentification (backend) ────────────────────────────────
# Secret de signature des tokens JWT. En production : 32 caractères minimum,
# différent de "change_me" (imposé par env.validation.ts).
JWT_SECRET=change_me
JWT_EXPIRATION=7d

# Compte administrateur - créé/resynchronisé automatiquement au démarrage
# par AdminSeedService. En production, ADMIN_PASSWORD suit la même règle de
# durcissement que JWT_SECRET ci-dessus.
ADMIN_EMAIL=admin@gaslands.local
ADMIN_PASSWORD=change_me_in_env

# ── Anti-abus / déploiement public (requis en NODE_ENV=production) ────────
# Clé SECRÈTE Cloudflare Turnstile (captcha à l'inscription), utilisée côté
# backend pour vérifier le jeton résolu par le widget.
# La clé de SITE (publique, pas un secret) ne va PAS ici : elle se renseigne
# dans apps/frontend/src/environments/environment.prod.ts
# (`turnstileSiteKey`), committée dans le code - cf. commentaire dans ce
# fichier pour le pourquoi (pas de config à l'exécution côté frontend).
TURNSTILE_SECRET_KEY=
# Origine(s) autorisée(s) pour CORS, séparées par des virgules.
CORS_ORIGIN=http://localhost:4200
# Nom de domaine public (certificat TLS Let's Encrypt via le stack Caddy
# partagé docker/edge/ - cf. docker/caddy/gaslands.caddy). LETSENCRYPT_EMAIL
# n'est PAS ici : ce stack étant partagé entre applications, sa variable vit
# dans son propre .env (docker/edge/.env), jamais dans celui-ci.
PUBLIC_DOMAIN=

# ── Limite de débit (@nestjs/throttler) ────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# ── Image Docker (production uniquement) ──────────────────────
# Tag des images pré-construites par CI (ghcr.io/arnaudbracchetti/
# gaslands-manager-{backend,frontend}) que docker-compose.prod.yml va
# `pull`. Vide ou absent -> "latest" (dernière release taguée). Renseigner
# une version précise (ex. v1.0.0) pour figer le déploiement.
IMAGE_TAG=

# ── Base de données - schéma ────────────────────────────────────
# En développement (docker-compose.yml) : synchronize=true reste pratique.
# En production (docker-compose.prod.yml) : toujours false - le schéma
# évolue par migrations explicites (`DB_MIGRATIONS_RUN=true`), jamais par
# synchronisation automatique sur une base contenant des données réelles.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
